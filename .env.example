# ============================================================
#  SALON CRM — DOCKER DEPLOYMENT ENVIRONMENT VARIABLES
#  Copy this file to .env before starting Docker containers:
#  cp .env.example .env
# ============================================================

# ── Port Configurations (As Requested) ─────────────────────
# Frontend published port on host (access in browser via http://<SERVER_IP>:95)
FRONTEND_PORT=95

# Backend API published port on host (direct API access via http://<SERVER_IP>:5012)
BACKEND_PORT=5012

# Internal port used inside backend container
BACKEND_INTERNAL_PORT=5000

# MongoDB published port on host (optional, for direct DB management tools)
MONGO_PORT=27017

# ── Container & Service Names ──────────────────────────────
FRONTEND_CONTAINER_NAME=salon-crm-frontend
BACKEND_CONTAINER_NAME=salon-crm-backend
MONGO_CONTAINER_NAME=salon-crm-mongo
MONGO_DB_NAME=salon-crm

# ── Application Environment ────────────────────────────────
NODE_ENV=production
API_PREFIX=/api/v1
SALON_NAME=Luxe Salon CRM
SALON_TIMEZONE=Asia/Kolkata

# ── Database Connection ────────────────────────────────────
# Connects to the bundled Mongo container by default
MONGODB_URI=mongodb://mongo:27017/salon-crm

# ── JWT Security Secrets (Replace with secure random strings) ─
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_ACCESS_SECRET_32_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_REFRESH_SECRET_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS Settings (Comma-separated allowed origins or *) ───
CORS_ALLOWED_ORIGINS=http://localhost:95,http://localhost:5173,*

# ── SMS / OTP Service (Optional Twilio integration) ────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Initial Admin Credentials (Optional for seeding) ───────
SEED_ADMIN_EMAIL=admin@salon.com
SEED_ADMIN_PASSWORD=Admin@Salon2026!

# ── Frontend Build Arguments ───────────────────────────────
VITE_API_BASE_URL=/api
