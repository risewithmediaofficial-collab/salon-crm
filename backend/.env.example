# ============================================================
#  SALON CRM — BACKEND ENVIRONMENT VARIABLES
#  Copy this to .env and fill in actual values
# ============================================================

# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/salon-crm

# JWT
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP (Twilio)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# CORS — comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Salon Info (single salon)
SALON_NAME=My Salon
SALON_TIMEZONE=Asia/Kolkata

# Admin Seed (first-time setup only — remove after seed)
SEED_ADMIN_EMAIL=admin@salon.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
